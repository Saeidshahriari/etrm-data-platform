# ==========================================================================
# ETRM Data Platform - environment template
# Copy this file to ".env" and adjust the values. ".env" is git-ignored.
# docker-compose reads ".env" automatically.
# ==========================================================================

# --- Airflow runtime ---
# On Linux/Mac set this to your host user id (run: id -u). On Windows keep 50000.
AIRFLOW_UID=50000
# Password for the Airflow admin user created at init time.
AIRFLOW_ADMIN_PASSWORD=admin

# --- Airflow security keys (CHANGE THESE) ---
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Any long random string for signing web/JWT sessions.
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# --- HashiCorp Vault (bootstrap secrets) ---
# Dev-mode root token. In production use a real auth method instead.
VAULT_TOKEN=dev-root-token

# --- ETRM application database (seeded into Vault by vault-init) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=etrm_db
DB_USER=etrm_user
DB_PASS=etrm_password

# --- External market data ---
# SMARD (the default source) is public and needs no key.
# Fill this only if you switch fetch_market_data.py to the ENTSO-E API.
ENTSOE_API_KEY=
